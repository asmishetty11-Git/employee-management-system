{
  "info": {
    "_postman_id": "8a481b21-7f06-4dbe-a9d8-3a0124eb09da",
    "name": "Employee Management API",
    "description": "Postman requests for the Spring Boot employee management API. Set baseUrl and employeeId as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/healthz"
      }
    },
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Filter employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees?department=Engineering&status=ACTIVE&sortBy=name&direction=asc"
      }
    },
    {
      "name": "Search by name or ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/search?name=alex"
      }
    },
    {
      "name": "Get employee",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/{{employeeId}}"
      }
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Casey Rivera\",\n  \"email\": \"casey.rivera@example.com\",\n  \"phone\": \"+1 555 010 4025\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"salary\": 7200.00,\n  \"joiningDate\": \"2024-06-01\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Casey Rivera\",\n  \"email\": \"casey.rivera@example.com\",\n  \"phone\": \"+1 555 010 4025\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Senior Software Engineer\",\n  \"salary\": 8200.00,\n  \"joiningDate\": \"2024-06-01\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/employees/{{employeeId}}"
      }
    },
    {
      "name": "Dashboard statistics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/dashboard/stats"
      }
    },
    {
      "name": "Departments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/departments"
      }
    },
    {
      "name": "Download employee CSV",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/reports/employees.csv"
      }
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/employees/{{employeeId}}"
      }
    }
  ]
}
